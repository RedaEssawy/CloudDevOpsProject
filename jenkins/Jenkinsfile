@Library('shared-library') _
pipeline {
    agent any
    
    environment {
        APP_NAME = "CloudDevOpsApp"
        IMAGE_NAME = "redaeid/${APP_NAME}"  // You can modify this
        DOCKERHUB_CREDENTIALS = 'dockerHub-credentials'
        DEPLOYMENT_FILE = "kubernetes/deployment.yaml"
        // MANIFESTS_REPO = "git@github.com:yourusername/k8s-manifests.git"  // Update with your manifests repo
        // MANIFESTS_BRANCH = "main"
        // GIT_CREDENTIALS_ID = 'github-credentials'
        API_SERVER = 'APIServer'
        SERVICEACCOUNT_TOKEN = 'ServiceAccount-Token'
        // For Trivy scan
        TRIVY_IGNORE_UNFIXED = 'true'
        TRIVY_SEVERITY = 'CRITICAL,HIGH'
    }

    stages {
        stage('Setup Environment') {
            steps {
                dir('docker/FinalProject') {
                script {
                    echo "Setting up Python environment..."
                    sh '''
                        python3 -m venv venv
                        . venv/bin/activate
                        pip install --upgrade pip
                        if [ -f FinalProject/requirements.txt ]; then
                            pip install -r FinalProject/requirements.txt
                        fi
                    '''
                }}
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    echo "Building Docker image: ${IMAGE_NAME}:${BUILD_NUMBER}"
                
                        buildDockerImage(
                            imageName: IMAGE_NAME,
                            tag: BUILD_NUMBER,
                            dockerfilePath: 'docker/Dockerfile',
                            buildContext: '.',
                        )
                    
                }
            }
        }

        stage('Scan Docker Image') {
            steps {
                script {
                    echo "Scanning Docker image with Trivy..."
                    // Using shared library function for image scanning
                    scanDockerImage(
                        imageName: IMAGE_NAME,
                        tag: BUILD_NUMBER,
                        severity: TRIVY_SEVERITY,
                        ignoreUnfixed: TRIVY_IGNORE_UNFIXED
                    )
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                script {
                    echo "Pushing Docker image to registry..."
                    pushDockerImage(
                        imageName: IMAGE_NAME,
                        tag: BUILD_NUMBER,
                        credentialsId: DOCKERHUB_CREDENTIALS
                    )
                    
                    // Also tag and push as 'latest'
                    sh """
                        docker tag ${IMAGE_NAME}:${BUILD_NUMBER} ${IMAGE_NAME}:latest
                        docker push ${IMAGE_NAME}:latest
                    """
                }
            }
        }

        stage('Delete Local Docker Image') {
            steps {
                script {
                    echo "Cleaning up local Docker images..."
                    sh """
                        docker rmi ${IMAGE_NAME}:${BUILD_NUMBER} || true
                        docker rmi ${IMAGE_NAME}:latest || true
                    """
                }
            }
        }

        stage('Update Manifests') {
            steps {
                script {
                    echo "Updating Kubernetes manifests with new image tag..."
                    dir('kubernetes') {
                    updateManifests(
                        // manifestsRepo: MANIFESTS_REPO,
                        // branch: MANIFESTS_BRANCH,
                        imageName: IMAGE_NAME,
                        newTag: BUILD_NUMBER,
                        deploymentFile: DEPLOYMENT_FILE,
                        // credentialsId: GIT_CREDENTIALS_ID
                    )
                }
            }
        }}

        // stage('Push Manifests') {
        //     steps {
        //         script {
        //             echo "Pushing updated manifests to repository..."
        //             pushManifests(
        //                 manifestsRepo: MANIFESTS_REPO,
        //                 branch: MANIFESTS_BRANCH,
        //                 credentialsId: GIT_CREDENTIALS_ID,
        //                 commitMessage: "Update image tag to ${BUILD_NUMBER} for ${APP_NAME}"
        //             )
        //         }
        //     }
        // }
    }

    post {
        always {
            echo "Cleaning up workspace..."
            cleanWs()
        }
        success {
            echo "Pipeline completed successfully! Image ${IMAGE_NAME}:${BUILD_NUMBER} has been built, scanned, and pushed."
            // You can add notifications here if needed
        }
        failure {
            echo "Pipeline failed. Please check the logs for details."
            // You can add failure notifications here
        }
    }
}